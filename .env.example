# Copy to .env and adjust.
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL: postgresql://user:password@host:5432/mentora (postgres:// also accepted)
# Browser origins allowed to call the API, comma-separated (the frontend URL in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
TOKEN_EXPIRE_MINUTES=120
# Uploaded proof files are stored under <UPLOAD_DIR>/proofs/
UPLOAD_DIR=uploads

# Outgoing email. Leave SMTP_HOST empty to log and skip emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mentora <no-reply@example.com>
SMTP_STARTTLS=true

# In-process scheduler (daily 00:05 IST deadline scan + escalation,
# reminders every 15 min). Run one worker, or set false and use the endpoint.
SCHEDULER_ENABLED=true
# Secret for POST /api/v1/admin/jobs/run (X-Job-Secret header); empty disables it.
JOB_SECRET=

# Used only by: python -m scripts.seed_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
